.env
node_modules/
scripts/*
!scripts/migrate.js
# 2026-09-09：审计/分区工具要入库。它们是发现「代码写对了但没接上」那类静默故障的主力
# （列缺失扫描一次揪出三个真 bug），也是 server.js 继续拆分时的依赖分析与路由核对工具。
# 一次性的调试脚本仍然照旧不入库。
!scripts/audit/
!scripts/audit/*.cjs
.env.zeabur
# 运行时产物（dfid 有环境变量 KUGOU_DFID_SEED 兜底，不需要进 git）
.kugou-dfid
# 调试/临时文件
_watch.cjs
night-check.webp

# 调试产物（GraphQL/build 日志临时文件）
_*.json

# 记忆清洗前备份（一次性清洗产物，不进 git）
backup_memories_before_clean.json

# 全量数据备份（敏感，不进 git）
backup/

# SSE 轨迹录制（真实回复内容敏感，不进 git；synthetic 合成 fixture 保留给回放测试）
sse-traces/*
!sse-traces/synthetic/

# 2026-09-08 补齐：本地探针/验证脚本，沿用已有的 _watch.cjs 那条约定推广成通配。
# （_*.json 早就有了，这里补 cjs/mjs 两种后缀）
_*.cjs
_*.mjs

# 构建产物散落在 public/ 根的重复副本：index.html 引的是 /assets/ 下那份，
# 根目录这两份是拷贝时多出来的，字节完全相同、没人引用。不入库；磁盘上可以直接删。
/public/index-*.js
/public/index-*.css
